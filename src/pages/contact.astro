---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact"
  description="Get in touch with DevToolsHub."
>
  <section class="page">
    <h1>Contact</h1>
    <p>
      Have a question, correction, or tool you'd like reviewed? Reach out at
      <a href="mailto:youremail@example.com">youremail@example.com</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 700px;
    margin: 3rem auto;
    padding: 0 2rem;
  }
  .page p {
    line-height: 1.7;
    color: #333;
  }
</style>