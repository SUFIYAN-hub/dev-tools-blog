---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="About"
  description="Who's behind DevToolsHub and why these reviews are different."
>
  <section class="page">
    <h1>About DevToolsHub</h1>
    <p>
      I'm a full-stack developer who actually builds with the tools I write about —
      not just reads their landing pages. DevToolsHub covers AI coding assistants
      and backend/infrastructure tools, with hands-on reviews based on real projects.
    </p>
    <p>
      Every comparison and review here comes from time spent actually using the
      tool in a real codebase, not marketing copy rewritten in different words.
    </p>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 700px;
    margin: 3rem auto;
    padding: 0 2rem;
  }
  .page p {
    line-height: 1.7;
    color: #333;
    margin-bottom: 1.25rem;
  }
</style>