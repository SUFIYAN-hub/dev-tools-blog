---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        {post.data.category} · {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · by {post.data.author}
      </p>
    </header>
    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 750px;
    margin: 3rem auto;
    padding: 0 2rem;
  }
  .meta {
    color: #888;
    font-size: 0.9rem;
    text-transform: capitalize;
    margin-bottom: 2rem;
  }
  .content :global(h2) {
    margin-top: 2rem;
  }
  .content :global(p) {
    line-height: 1.7;
    color: #333;
  }
</style>