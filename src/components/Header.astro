---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'AI Tools', href: '/blog?category=ai-tools' },
  { label: 'Backend & Infra', href: '/blog?category=backend-infra' },
  { label: 'About', href: '/about' },
];
---
<header class="site-header">
  <nav>
    <a href="/" class="logo">DevToolsHub</a>
    <ul class="nav-links">
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid #e2e2e2;
    padding: 1rem 2rem;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
  }
  .logo {
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    color: inherit;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    text-decoration: none;
    color: inherit;
  }
  .nav-links a:hover {
    text-decoration: underline;
  }
</style>